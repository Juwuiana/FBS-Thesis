# Copy this file to .env and fill in real values. .env is gitignored.

# Long random string used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=3ce7eb264e0ae5e983c223010555fac15781158adf19455c58e9b440b47cf4af

# Optional. If unset, the app stores the sqlite file at
# instance/fbs_thesis.sqlite3 automatically.
DATABASE_PATH=instance/fbs_thesis.sqlite3

# Set to False to let new sign-ups log in immediately without an admin
# approving them first (handy while developing).
REQUIRE_ADMIN_APPROVAL=True

# --- Green computing (see README) ---
# FBS_TIMEZONE=Asia/Manila
# FBS_BATTERY_DIR=/sys/class/power_supply/battery
# FBS_CURRENT_UNIT=auto            # auto | uA | mA
# FBS_POWER_FEED=grid              # grid | solar_ups
# FBS_EMISSION_FACTOR=0.6          # kg CO2 per kWh - PLACEHOLDER, cite your source
# FBS_IDLE_POWER_W=0               # measure the idle phone once and set it
# FBS_TARGET_KWH_PER_SCREEN=0.000001
# FBS_TARGET_IDLE_W=1.0
# FLASK_DEBUG=0                    # never 1 on the phone: the debugger allows remote code execution
# FBS_SINGLE_SESSION_POLICY=block  # block | replace: a 2nd staff login is rejected (block) or signs the old device out (replace)
# FBS_DEMO_MODE=1                 # presentation only: demo buttons on the Green Computing page
# --- Connectivity monitor / offline queue ---
# FBS_PROBE_TARGETS=1.1.1.1:53,8.8.8.8:53   # what "online" means (host:port, any answering = up)
# FBS_PROBE_INTERVAL_S=15
# FBS_PROBE_TIMEOUT_S=2
# FBS_PROBE_FAIL_THRESHOLD=3                # consecutive failures before DOWN (delay = 3 x 15 s)
# FBS_PROBE_OK_THRESHOLD=2                  # consecutive successes before UP
# FBS_SYNC_TRANSPORT=none                   # none | (registered name); no upstream exists yet
