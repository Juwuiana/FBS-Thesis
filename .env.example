# Copy this file to .env and fill in real values. .env is gitignored.

# Long random string used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=3ce7eb264e0ae5e983c223010555fac15781158adf19455c58e9b440b47cf4af

# Optional. If unset, the app stores the sqlite file at
# instance/fbs_thesis.sqlite3 automatically.
DATABASE_PATH=instance/fbs_thesis.sqlite3

# Set to False to let new sign-ups log in immediately without an admin
# approving them first (handy while developing).
REQUIRE_ADMIN_APPROVAL=False
